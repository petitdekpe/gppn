# Variables du pipeline de traitement vidéo asynchrone (voir
# src/MessageHandler/ProcessVideoHandler.php et config/packages/messenger.yaml).
# Les autres variables applicatives (base de données, mailer, etc.) sont
# documentées directement dans .env, le fichier commité de ce dépôt.

# Chemins vers les binaires FFmpeg/FFprobe. Laisser le nom seul pour une
# résolution via le PATH, ou renseigner un chemin absolu si les binaires ne
# sont pas dans le PATH du serveur (ex: FFMPEG_BINARY=/usr/local/bin/ffmpeg).
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# 1 : une capsule vidéo passe automatiquement en statut "Publié" une fois le
# transcodage terminé avec succès. 0 : elle passe en "En relecture" et
# attend une validation manuelle dans le back-office.
VIDEO_PIPELINE_AUTO_PUBLISH=1

# DSN du transport Messenger "async" en production (driver Redis). En
# développement, ce transport utilise Doctrine via MESSENGER_TRANSPORT_DSN
# (voir .env) ; cette variable n'est lue que dans config/packages/messenger.yaml
# sous le bloc when@prod.
REDIS_MESSENGER_DSN=redis://localhost:6379/messages
