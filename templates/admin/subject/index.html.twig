{% extends 'admin/base.html.twig' %}

{% block title %}Sujets — Administration GPPN{% endblock %}
{% block page_title %}Sujets{% endblock %}

{% block body %}
    <div class="admin-toolbar">
        <a class="btn btn--primary" href="{{ path('admin_subject_new') }}">+ Nouveau sujet</a>
    </div>

    <p class="form-help">Un sujet regroupe les contenus (langues, ou plusieurs fois la même langue) qui traitent du même point à l'ordre du jour d'un conseil des ministres.</p>

    {% if subjects is empty %}
        <p class="empty-state">Aucun sujet pour le moment.</p>
    {% else %}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Conseil des ministres</th>
                        <th>Thématique</th>
                        <th>Titre du sujet</th>
                        <th>Contenus</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for subject in subjects %}
                        <tr>
                            <td>{{ subject.councilSession.label ?: subject.councilSession.date|date('d/m/Y') }}</td>
                            <td>{{ subject.thematic.name }}</td>
                            <td>{{ subject.referenceTitle }}</td>
                            <td>{{ videoCounts[subject.id] }}</td>
                            <td class="admin-table__actions">
                                <a class="btn btn--outline btn--sm" href="{{ path('admin_subject_edit', {id: subject.id}) }}">Modifier</a>
                                <form method="post" action="{{ path('admin_subject_delete', {id: subject.id}) }}" onsubmit="return confirm('Supprimer ce sujet ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-subject-' ~ subject.id) }}">
                                    <button type="submit" class="btn btn--danger btn--sm" {{ videoCounts[subject.id] > 0 ? 'disabled' }}>Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
