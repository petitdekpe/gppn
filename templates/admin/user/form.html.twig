{% extends 'admin/base.html.twig' %}

{% block title %}{{ user.id ? 'Modifier' : 'Nouvel' }} utilisateur — Administration GPPN{% endblock %}
{% block page_title %}{{ user.id ? 'Modifier l’utilisateur' : 'Nouvel utilisateur' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.role) }}
            {{ form_row(form.plainPassword) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_user_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
