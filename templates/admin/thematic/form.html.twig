{% extends 'admin/base.html.twig' %}

{% block title %}{{ thematic.id ? 'Modifier' : 'Nouvelle' }} thématique — Administration GPPN{% endblock %}
{% block page_title %}{{ thematic.id ? 'Modifier la thématique' : 'Nouvelle thématique' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.colorHex) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_thematic_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
