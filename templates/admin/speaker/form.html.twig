{% extends 'admin/base.html.twig' %}

{% block title %}{{ speaker.id ? 'Modifier' : 'Nouvel' }} intervenant — Administration GPPN{% endblock %}
{% block page_title %}{{ speaker.id ? 'Modifier l’intervenant' : 'Nouvel intervenant' }}{% endblock %}
{% block back_link %}{{ include('partials/_back_link.html.twig', {fallback: path('admin_speaker_index'), label: 'Retour aux intervenants'}) }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.fullName) }}
            {{ form_row(form.sigle) }}
            {{ form_row(form.role) }}
            {{ form_row(form.government) }}
            {{ form_row(form.precedence) }}

            <div class="admin-form-card__file-slot">
                {{ form_label(form.photoFile) }}
                {{ form_help(form.photoFile) }}
                {% if form.photoFile.vars.image_uri %}
                    <p class="form-help">Photo actuelle :</p>
                    <img class="admin-speaker-photo" src="{{ form.photoFile.vars.image_uri }}" alt="">
                {% endif %}
                {{ form_widget(form.photoFile) }}
                {{ form_errors(form.photoFile) }}
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_speaker_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
