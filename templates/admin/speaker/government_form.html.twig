{% extends 'admin/base.html.twig' %}

{% block title %}{{ government.id ? 'Modifier le' : 'Nouveau' }} gouvernement | Administration GPPN{% endblock %}
{% block page_title %}{{ government.id ? 'Modifier le gouvernement' : 'Nouveau gouvernement' }}{% endblock %}
{% block back_link %}{{ include('partials/_back_link.html.twig', {fallback: path('admin_speaker_index'), label: 'Retour aux intervenants'}) }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {% if not government.id %}
            <p class="form-help">Après un remaniement : créez le nouveau gouvernement, puis, depuis la liste, sélectionnez les intervenants du gouvernement précédent qui restent en fonction et choisissez « Reconduire dans… ».</p>
        {% endif %}
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.label) }}
            {{ form_row(form.startedAt) }}
            {{ form_row(form.current) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_speaker_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
