{% extends 'admin/base.html.twig' %}

{% block title %}Mon mot de passe — Administration GPPN{% endblock %}
{% block page_title %}Changer mon mot de passe{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.newPassword.first, {help: 'Au moins 8 caractères.'}) }}
            {{ form_row(form.newPassword.second) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Changer le mot de passe</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
