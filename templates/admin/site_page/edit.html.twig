{% extends 'admin/base.html.twig' %}

{% block title %}{{ page.title }} | Administration GPPN{% endblock %}
{% block page_title %}Modifier la page « {{ page.title }} »{% endblock %}
{% block back_link %}{{ include('partials/_back_link.html.twig', {fallback: path('admin_site_page_index'), label: 'Retour aux pages'}) }}{% endblock %}

{% block body %}
    <div class="admin-form-card site-page-editor"
         data-controller="markdown-preview"
         data-markdown-preview-url-value="{{ path('admin_site_page_preview') }}"
         data-markdown-preview-token-value="{{ csrf_token('site-page-preview') }}">
        <p class="admin-settings__help">
            {{ definition.help }}
            {% if page.updatedAt %}
                Dernière modification le {{ page.updatedAt|datetime_fr }}{% if page.updatedBy %} par {{ page.updatedBy.fullName ?: page.updatedBy.email }}{% endif %}.
            {% else %}
                Le site affiche pour l’instant le texte par défaut.
            {% endif %}
            <a href="{{ path(definition.route) }}" target="_blank" rel="noopener">Voir la page ↗</a>
        </p>
        {% if '[à compléter' in page.content %}
            <p class="admin-settings__warning">Ce texte contient des informations à compléter, entre crochets : <code>[à compléter …]</code>. Remplacez-les par les informations réelles avant de diffuser le site.</p>
        {% endif %}

        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}

            <div class="site-page-editor__tabs" role="tablist">
                <button type="button" role="tab" class="site-page-editor__tab is-active" aria-selected="true" data-markdown-preview-target="writeTab" data-action="markdown-preview#write">Écrire</button>
                <button type="button" role="tab" class="site-page-editor__tab" aria-selected="false" data-markdown-preview-target="previewTab" data-action="markdown-preview#preview">Aperçu</button>
            </div>
            <div data-markdown-preview-target="editor">
                {{ form_row(form.content) }}
            </div>
            <div class="site-page-editor__preview" data-markdown-preview-target="output" hidden></div>

            <details class="site-page-editor__help">
                <summary>Mise en forme du texte</summary>
                <table class="admin-table">
                    <tbody>
                        <tr><td><code>## Titre de section</code></td><td>Titre de section</td></tr>
                        <tr><td><code>### Sous-titre</code></td><td>Sous-titre</td></tr>
                        <tr><td><code>**texte important**</code></td><td><strong>texte important</strong></td></tr>
                        <tr><td><code>*texte en italique*</code></td><td><em>texte en italique</em></td></tr>
                        <tr><td><code>- élément de liste</code></td><td>Liste à puces (une ligne par élément)</td></tr>
                        <tr><td><code>1. élément numéroté</code></td><td>Liste numérotée</td></tr>
                        <tr><td><code>[texte du lien](https://exemple.bj)</code></td><td>Lien (adresse complète, ou <code>/nous-contacter</code> pour une page du site)</td></tr>
                        <tr><td>Ligne vide</td><td>Nouveau paragraphe</td></tr>
                    </tbody>
                </table>
                <p class="form-help">Le code HTML saisi est affiché tel quel, sans être interprété.</p>
            </details>

            <label class="admin-check">
                {{ form_widget(form.restoreDefault) }}
                <span>{{ form.restoreDefault.vars.label }}</span>
            </label>

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_site_page_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
