{% extends 'admin/base.html.twig' %}

{% block title %}{{ suggestion.subject }} — Administration GPPN{% endblock %}
{% block page_title %}Suggestion{% endblock %}

{% block body %}
    <div class="admin-form-card">
        <span class="admin-badge {{ suggestion.treated ? 'admin-badge--done' : 'admin-badge--pending' }}">
            {{ suggestion.treated ? 'Traitée' : 'À traiter' }}
        </span>

        <h2>{{ suggestion.subject }}</h2>
        <p class="muted">
            Reçue le {{ suggestion.createdAt|date('d/m/Y à H:i') }}
            {% if suggestion.fullName %} · {{ suggestion.fullName }}{% endif %}
            {% if suggestion.email %} · <a href="mailto:{{ suggestion.email }}">{{ suggestion.email }}</a>{% endif %}
        </p>

        <p class="admin-suggestion-message">{{ suggestion.message|nl2br }}</p>

        <div class="admin-form-actions">
            <form method="post" action="{{ path('admin_suggestion_toggle_treated', {id: suggestion.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-suggestion-' ~ suggestion.id) }}">
                <button type="submit" class="btn btn--primary">
                    {{ suggestion.treated ? 'Marquer comme à traiter' : 'Marquer comme traitée' }}
                </button>
            </form>
            <form method="post" action="{{ path('admin_suggestion_delete', {id: suggestion.id}) }}" onsubmit="return confirm('Supprimer cette suggestion ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-suggestion-' ~ suggestion.id) }}">
                <button type="submit" class="btn btn--danger">Supprimer</button>
            </form>
            <a class="btn btn--outline" href="{{ path('admin_suggestion_index') }}">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
