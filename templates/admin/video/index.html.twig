{% extends 'admin/base.html.twig' %}

{% block title %}Contenus — Administration GPPN{% endblock %}
{% block page_title %}Contenus{% endblock %}

{% block body %}
    {# Colonne « Formats » : clés de Video::getDistributionFiles(). #}
    {% set formatIcons = {
        tv: {label: 'Vidéo TV', icon: 'fa-tv'},
        mobile: {label: 'Vidéo Mobile', icon: 'fa-mobile-screen-button'},
        audio: {label: 'Audio MP3', icon: 'fa-headphones'},
    } %}

    <div class="admin-toolbar">
        <a class="btn btn--primary" href="{{ path('admin_video_new') }}">+ Nouveau contenu</a>
    </div>

    {% if sessions is empty %}
        <p class="empty-state">Aucun contenu pour le moment.</p>
    {% else %}
        <div class="admin-videos-layout" data-controller="council-calendar" data-council-calendar-sessions-value="{{ calendar|json_encode }}" data-council-calendar-selected-value="{{ selectedSessionId }}" data-council-calendar-sync-url-value="true" data-council-calendar-navigate-value="true">
            {{ include('partials/_council_calendar.html.twig') }}

            <div class="admin-videos-layout__list" data-controller="bulk-select">
                {{ include('admin/_bulk_bar.html.twig', {
                    formId: 'bulk-video',
                    action: path('admin_video_bulk'),
                    tokenId: 'bulk-video',
                    actions: [
                        {value: 'publish', label: 'Publier'},
                        {value: 'draft', label: 'Passer en brouillon'},
                        {value: 'hide', label: 'Masquer du site'},
                        {value: 'feature', label: 'Mettre à la une'},
                        {value: 'unfeature', label: 'Retirer de la une'},
                        {value: 'cover', label: 'Générer la couverture (vidéo à 15 s)', confirm: 'Remplacer la couverture des %count% contenus sélectionnés par l’image de leur vidéo à 15 s (TV, à défaut Mobile), y compris les couvertures déposées à la main ?'},
                        {value: 'delete', label: 'Supprimer', confirm: 'Supprimer définitivement les %count% contenus sélectionnés et leurs fichiers ?'},
                    ],
                }) }}
                {# Sans JavaScript, seul le conseil sélectionné (par défaut le dernier) est affiché. #}
                {% for group in sessions %}
                    {% set session = group.session %}
                    <section class="admin-session" data-council-calendar-target="panel" data-session-id="{{ session.id }}" aria-labelledby="council-{{ session.id }}"{{ session.id != selectedSessionId ? ' hidden' }}>
                        <header class="admin-session__summary">
                            <h2 class="admin-session__title" id="council-{{ session.id }}">{{ session.title }}</h2>
                            <span class="admin-table__count">{{ group.count }} contenu{{ group.count > 1 ? 's' }}</span>
                        </header>
                        <div class="admin-table-wrap">
                            <table class="admin-table admin-table--grouped">
                                <thead>
                                    <tr>
                                        {{ include('admin/_bulk_all.html.twig') }}
                                        <th>Intervenant</th>
                                        <th>Langue</th>
                                        <th>Formats</th>
                                        <th>Statut</th>
                                        <th>Publiée le</th>
                                        <th>Vues</th>
                                        <th>À la une</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in group.subjects %}
                                        <tr class="admin-table__subject">
                                            <th colspan="9" scope="rowgroup">
                                                {{ item.subject.title }}
                                                <span class="admin-table__thematic" style="color: {{ item.subject.thematic.colorHex }}">{{ item.subject.thematic.name }}</span>
                                            </th>
                                        </tr>
                                        {% for video in item.videos %}
                                            <tr>
                                                {{ include('admin/_bulk_checkbox.html.twig', {formId: 'bulk-video', id: video.id, label: item.subject.title ~ ' — ' ~ video.language.name}) }}
                                                <td>
                                                    {% if video.speaker %}
                                                        <strong class="admin-table__speaker" title="{{ video.speaker.fullName }}">{{ video.speaker.sigle ?: video.speaker.fullName }}</strong>
                                                    {% else %}
                                                        <span class="admin-table__muted">—</span>
                                                    {% endif %}
                                                </td>
                                                <td><a href="{{ path('app_video_show', {slug: video.slug}) }}" target="_blank" rel="noopener">{{ video.language.name }}</a></td>
                                                <td>
                                                    {# Formats de diffusion déposés : allumés si présents, estompés sinon. #}
                                                    <span class="admin-formats">
                                                        {% for key, file in video.distributionFiles %}
                                                            {% set format = formatIcons[key] %}
                                                            {% set title = file ? format.label ~ ' : ' ~ (file.originalName ?? file.fileName) : format.label ~ ' : absent' %}
                                                            <i class="fa-solid {{ format.icon }} admin-formats__icon{{ file ? ' is-available' }}" title="{{ title }}" aria-hidden="true"></i>
                                                            <span class="sr-only">{{ title }}.</span>
                                                        {% endfor %}
                                                    </span>
                                                </td>
                                                <td>{{ video.status.label }}</td>
                                                <td>{{ video.publishedAt|date_fr }}</td>
                                                <td>{{ video.viewsCount|number_format(0, ',', ' ') }}</td>
                                                <td>{{ video.featured ? 'Oui' : 'Non' }}</td>
                                                <td class="admin-table__actions">
                                                    {% set videoName = item.subject.title ~ ' — ' ~ video.language.name %}
                                                    <a class="btn btn--outline btn--sm btn--icon" href="{{ path('admin_video_edit', {id: video.id}) }}" title="Modifier" aria-label="Modifier {{ videoName }}">
                                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                    </a>
                                                    <form method="post" action="{{ path('admin_video_delete', {id: video.id}) }}" onsubmit="return confirm('Supprimer ce contenu ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-video-' ~ video.id) }}">
                                                        <button type="submit" class="btn btn--danger btn--sm btn--icon" title="Supprimer" aria-label="Supprimer {{ videoName }}">
                                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
