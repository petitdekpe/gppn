{% extends 'admin/base.html.twig' %}

{% block title %}{{ video.id ? 'Modifier' : 'Nouvelle' }} vidéo — Administration GPPN{% endblock %}
{% block page_title %}{{ video.id ? 'Modifier la vidéo' : 'Nouvelle vidéo' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.slug) }}
            {{ form_row(form.summary) }}
            <div class="form-grid-2">
                {{ form_row(form.format) }}
                {{ form_row(form.status) }}
            </div>
            {{ form_row(form.sourceFile) }}
            <div class="form-grid-2">
                {{ form_row(form.thematic) }}
                {{ form_row(form.language) }}
            </div>
            <div class="form-grid-2">
                {{ form_row(form.durationSeconds) }}
                {{ form_row(form.viewsCount) }}
            </div>
            {{ form_row(form.publishedAt) }}
            {{ form_row(form.downloadFile) }}
            {% if video.downloadFileName %}
                <p class="form-help">Fichier actuel : <a href="{{ video_download_url(video) }}" target="_blank" rel="noopener">{{ video.downloadFileOriginalName ?? video.downloadFileName }}</a></p>
            {% endif %}
            {{ form_row(form.learningPoints) }}
            {{ form_row(form.featured) }}
            {{ form_row(form.speakers) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_video_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
