{% extends 'admin/base.html.twig' %}

{% block title %}{{ video.id ? 'Modifier' : 'Nouveau' }} contenu — Administration GPPN{% endblock %}
{% block page_title %}{{ video.id ? 'Modifier le contenu' : 'Nouveau contenu' }}{% endblock %}

{% block body %}
    {% set playbackFile = video.primaryPlaybackFile %}
    {% set playbackCategory = playbackFile ? playbackFile.type.category.value : null %}
    <div class="admin-form-card">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.summary) }}
            <div class="form-grid-2">
                {{ form_row(form.status) }}
                {{ form_row(form.durationSeconds) }}
            </div>
            {{ form_row(form.language) }}
            {{ form_row(form.subject) }}

            <h2>Fichiers proposés au téléchargement</h2>
            <p class="form-help">Un contenu peut proposer n'importe laquelle de ces variantes, sans obligation de toutes les fournir.</p>
            {% for fileForm in form.files %}
                {% set videoFile = fileForm.vars.data %}
                <div class="admin-form-card__file-slot">
                    <label>{{ videoFile.type.label }}</label>
                    <p class="form-help">{{ videoFile.type.description }}</p>
                    {{ form_widget(fileForm.file) }}
                    {{ form_errors(fileForm.file) }}
                    {% if videoFile.fileName %}
                        <p class="form-help">Fichier actuel : <a href="{{ video_file_url(videoFile) }}" target="_blank" rel="noopener">{{ videoFile.originalName ?? videoFile.fileName }}</a> ({{ (videoFile.fileSize / 1048576)|round(1) }} Mo)</p>
                    {% endif %}
                </div>
            {% endfor %}

            {% if playbackFile %}
                {% set initialX = form.coverPositionX.vars.value %}
                {% set initialY = form.coverPositionY.vars.value %}
                <div class="admin-form-card__file-slot">
                    <label>Cadrage de la couverture</label>
                    <p class="form-help">Glissez l'aperçu pour choisir la partie de l'image affichée en couverture (carte, à la une, fiche détail).</p>
                    <div class="cover-picker" data-controller="cover-picker">
                        <div class="cover-picker__frame" data-cover-picker-target="frame" data-action="pointerdown->cover-picker#start">
                            {% if playbackCategory == 'video' %}
                                <video class="cover-picker__media" data-cover-picker-target="media" muted preload="metadata" playsinline style="object-position: {{ initialX }}% {{ initialY }}%">
                                    <source src="{{ video_file_url(playbackFile) }}" type="{{ playbackFile.mimeType ?? 'video/mp4' }}">
                                </video>
                            {% else %}
                                <img class="cover-picker__media" data-cover-picker-target="media" src="{{ video_file_url(playbackFile) }}" alt="" draggable="false" style="object-position: {{ initialX }}% {{ initialY }}%">
                            {% endif %}
                        </div>
                        <div class="cover-picker__toolbar">
                            <span class="cover-picker__readout" data-cover-picker-target="readout">{{ initialX }}% / {{ initialY }}%</span>
                            <button type="button" class="btn btn--outline btn--sm" data-action="cover-picker#reset">Recentrer</button>
                        </div>
                        {{ form_widget(form.coverPositionX, {'attr': {'data-cover-picker-target': 'x'}}) }}
                        {{ form_widget(form.coverPositionY, {'attr': {'data-cover-picker-target': 'y'}}) }}
                    </div>
                </div>
            {% else %}
                {{ form_widget(form.coverPositionX) }}
                {{ form_widget(form.coverPositionY) }}
            {% endif %}

            {{ form_row(form.learningPoints) }}
            {{ form_row(form.featured) }}
            {{ form_row(form.speaker) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_video_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
