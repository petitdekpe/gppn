{% extends 'admin/base.html.twig' %}

{% block title %}{{ language.id ? 'Modifier' : 'Nouvelle' }} langue — Administration GPPN{% endblock %}
{% block page_title %}{{ language.id ? 'Modifier la langue' : 'Nouvelle langue' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_language_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
