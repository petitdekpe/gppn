<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>Connexion — Administration GPPN</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body class="admin-body admin-body--login">
        <div class="admin-login">
            <img class="admin-login__logo" src="{{ asset('images/logo-gppn.png') }}" alt="Le Gouvernement plus près de nous">
            <div class="admin-login__card">
                <h1>Administration</h1>

                {% if error %}
                    <div class="flash flash--error">
                        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    </div>
                {% endif %}

                <form method="post">
                    <div>
                        <label for="admin-email">Email</label>
                        <input type="email" id="admin-email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                    </div>
                    <div>
                        <label for="admin-password">Mot de passe</label>
                        <input type="password" id="admin-password" name="_password" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn--primary">Se connecter</button>
                </form>
            </div>
            <a class="admin-login__back" href="{{ path('app_home') }}">← Retour au site public</a>
        </div>
    </body>
</html>
