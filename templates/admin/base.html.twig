<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}Administration — Le Gouvernement plus près de nous{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="admin-body">
        <div class="admin-shell">
            <aside class="admin-sidebar">
                <a class="admin-sidebar__brand" href="{{ path('admin_dashboard') }}">
                    <img src="{{ asset('images/logo-gppn.png') }}" alt="Le Gouvernement plus près de nous">
                </a>
                <nav class="admin-nav">
                    <a href="{{ path('admin_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'is-active' }}">Tableau de bord</a>
                    {% if is_granted('ROLE_EDITEUR') %}
                        <a href="{{ path('admin_video_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_video' ? 'is-active' }}">Vidéos</a>
                        <a href="{{ path('admin_thematic_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_thematic' ? 'is-active' }}">Thématiques</a>
                        <a href="{{ path('admin_language_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_language' ? 'is-active' }}">Langues</a>
                        <a href="{{ path('admin_speaker_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_speaker' ? 'is-active' }}">Intervenants</a>
                    {% endif %}
                    {% if is_granted('ROLE_MODERATEUR') %}
                        <a href="{{ path('admin_suggestion_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_suggestion' ? 'is-active' }}">Suggestions</a>
                    {% endif %}
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <a href="{{ path('admin_user_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_user' ? 'is-active' }}">Utilisateurs</a>
                    {% endif %}
                </nav>
                <div class="admin-sidebar__footer">
                    <a href="{{ path('app_home') }}" target="_blank" rel="noopener">Voir le site ↗</a>
                    {% if app.user %}
                        <span class="admin-user">{{ app.user.userIdentifier }}</span>
                        <a href="{{ path('admin_logout') }}" class="admin-logout-link">Déconnexion</a>
                    {% endif %}
                </div>
            </aside>

            <div class="admin-main">
                <header class="admin-topbar">
                    <h1>{% block page_title %}{% endblock %}</h1>
                </header>

                <div class="admin-content">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash flash--{{ label }}">
                                <div>{{ message }}</div>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </div>
            </div>
        </div>
    </body>
</html>
