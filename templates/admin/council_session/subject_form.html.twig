{% extends 'admin/base.html.twig' %}

{% block title %}{{ subject.id ? 'Modifier' : 'Nouveau' }} sujet | Administration GPPN{% endblock %}
{% block page_title %}{{ subject.id ? 'Modifier le sujet' : 'Nouveau sujet' }}{% endblock %}
{% block back_link %}
    {% if videoFlow|default(false) %}
        {{ include('partials/_back_link.html.twig', {fallback: path('admin_video_new'), label: 'Retour au nouveau contenu'}) }}
    {% else %}
        {{ include('partials/_back_link.html.twig', {fallback: path('admin_council_session_index', {conseil: councilSession.id}), label: 'Retour au conseil des ministres'}) }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {% if videoFlow|default(false) %}
            <p class="admin-flow-note">Une fois enregistré, ce sujet sera sélectionné dans votre nouveau contenu.</p>
        {% endif %}
        <p class="form-help"><strong>{{ councilSession.title }}</strong></p>

        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.thematic) }}
            {{ form_row(form.title) }}
            {{ form_row(form.summary) }}
            {{ form_row(form.learningPoints) }}
            {{ form_row(form.keywords) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ videoFlow|default(false) ? path('admin_video_new') : path('admin_council_session_index', {conseil: councilSession.id}) }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
