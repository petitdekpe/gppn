{% extends 'admin/base.html.twig' %}

{% block title %}{{ subject.id ? 'Modifier' : 'Nouveau' }} sujet — Administration GPPN{% endblock %}
{% block page_title %}{{ subject.id ? 'Modifier le sujet' : 'Nouveau sujet' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        <p class="form-help">Conseil des ministres : <strong>{{ councilSession.label ?: councilSession.date|date('d/m/Y') }}</strong></p>

        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.thematic) }}
            {{ form_row(form.referenceTitle) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_council_session_edit', {id: councilSession.id}) }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
