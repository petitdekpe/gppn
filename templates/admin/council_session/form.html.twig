{% extends 'admin/base.html.twig' %}

{% block title %}{{ councilSession.id ? 'Modifier' : 'Nouveau' }} conseil des ministres — Administration GPPN{% endblock %}
{% block page_title %}{{ councilSession.id ? 'Modifier le conseil des ministres' : 'Nouveau conseil des ministres' }}{% endblock %}

{% block body %}
    <div class="admin-form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.date) }}
            {{ form_row(form.label) }}

            <div class="admin-form-actions">
                <button type="submit" class="btn btn--primary">Enregistrer</button>
                <a class="btn btn--outline" href="{{ path('admin_council_session_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
