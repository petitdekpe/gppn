<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Le Gouvernement plus près de nous{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Des contenus courts du Gouvernement du Bénin, en vidéo TV, vidéo Mobile et audio MP3, expliqués en Fon, Yoruba, Bariba, Dendi et d’autres langues nationales.{% endblock %}">
        {% block meta_keywords %}{% endblock %}
        {# Aperçu au partage (WhatsApp, Facebook, X…). Image par défaut : photo officielle du Gouvernement ;
           une fiche contenu la remplace par sa couverture. URL sans paramètres : un seul aperçu par page. #}
        <meta property="og:site_name" content="Le Gouvernement plus près de nous">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{% block og_title %}{{ block('title')|trim }}{% endblock %}">
        <meta property="og:description" content="{{ block('meta_description')|trim }}">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/hero-gouvernement.jpg')) }}{% endblock %}">
        <meta property="og:image:alt" content="{% block og_image_alt %}Les membres du Gouvernement de la République du Bénin{% endblock %}">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="icon" href="{{ asset('images/favicon-32.png') }}" sizes="32x32" type="image/png">
        <link rel="icon" href="{{ asset('images/favicon-16.png') }}" sizes="16x16" type="image/png">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header" data-controller="nav">
            <div class="site-header__bar">
                <div class="wrap site-header__inner">
                    <a class="brand" href="{{ path('app_home') }}">
                        <img class="brand__logo" src="{{ asset('images/logo-gppn.png') }}" alt="Le Gouvernement plus près de nous">
                        <img class="brand__picto" src="{{ asset('images/picto-logo-gppn.svg') }}" alt="" aria-hidden="true">
                    </a>

                    <button type="button" class="nav-toggle" data-action="nav#toggle" aria-expanded="false" aria-controls="primary-nav">
                        <span></span><span></span><span></span>
                        <span class="sr-only">Ouvrir le menu</span>
                    </button>

                    <nav class="primary-nav" id="primary-nav" data-nav-target="menu">
                        <a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'is-active' }}">Accueil</a>
                        <a href="{{ path('app_video_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_video' ? 'is-active' }}">Contenus</a>
                        <a href="{{ path('app_thematique_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_thematique' ? 'is-active' }}">Thématiques</a>
                        <a href="{{ path('app_intervenant_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_intervenant' or app.request.attributes.get('_route') starts with 'app_kit' ? 'is-active' }}">Les ministres</a>
                        <a href="{{ path('app_media_space') }}" class="{{ app.request.attributes.get('_route') == 'app_media_space' ? 'is-active' }}">Espace média</a>
                        <a href="{{ path('app_about') }}" class="{{ app.request.attributes.get('_route') == 'app_about' ? 'is-active' }}">À propos</a>
                    </nav>

                    <div class="header-search" data-controller="header-search" data-header-search-suggest-url-value="{{ path('app_search_suggest') }}">
                        <button type="button" class="header-search__toggle" data-header-search-target="toggle" data-action="header-search#toggle" aria-expanded="false" aria-controls="header-search-panel" aria-label="Rechercher">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                        </button>

                        <form class="header-search__panel" id="header-search-panel" data-header-search-target="panel" data-action="keydown.esc->header-search#close" action="{{ path('app_video_index') }}" method="get" role="search">
                            <label class="sr-only" for="header-search-input">Rechercher un contenu</label>
                            {# Suggestions à mesure que l'on tape (intervenants d'abord) : header_search_controller.js. #}
                            <input id="header-search-input" data-header-search-target="input" type="search" name="q" placeholder="Rechercher un sujet, un ministre…" value="{{ app.request.query.get('q') }}"
                                   autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="header-search-suggestions"
                                   data-action="input->header-search#suggest keydown->header-search#navigate focus->header-search#suggest">
                            <button type="submit" aria-label="Rechercher">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                            </button>
                        </form>
                        <div class="header-search__suggestions" id="header-search-suggestions" role="listbox" aria-label="Suggestions" data-header-search-target="list" hidden></div>
                    </div>
                </div>
            </div>
            <div class="site-header__stripe" aria-hidden="true"></div>
        </header>

        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash--{{ label }}">
                        <div class="wrap">{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% if app.request.attributes.get('_route') != 'app_video_feed' %}
            <a href="{{ path('app_video_feed') }}" class="feed-fab" aria-label="Ouvrir le fil des vidéos Mobile" data-controller="feed-fab">
                <i class="fa-solid fa-play" aria-hidden="true"></i>
            </a>
        {% endif %}

        <footer class="site-footer">
            <div class="wrap site-footer__grid">
                <div class="site-footer__about">
                    <div class="brand brand--footer">
                        <img class="brand__logo brand__logo--footer" src="{{ asset('images/logo-gouv.png') }}" alt="Gouvernement de la République du Bénin" loading="lazy">
                    </div>
                    <h3>Abonnez-vous à notre Newsletter</h3>
                    <p class="site-footer__newsletter-text">Recevez par e-mail les nouveaux contenus du Gouvernement dès leur publication : vidéos TV, vidéos Mobile et audios MP3 qui expliquent les décisions du Conseil des ministres, dans les langues nationales.</p>
                    <form class="newsletter-form" action="{{ path('app_home') }}" method="get">
                        <input type="email" name="email" placeholder="Votre adresse e-mail" required>
                        <button type="submit" aria-label="S’abonner">→</button>
                    </form>
                </div>

                <div class="site-footer__links">
                    <h4>Rubriques</h4>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_video_index') }}">Contenus</a></li>
                        <li><a href="{{ path('app_thematique_index') }}">Thématiques</a></li>
                        <li><a href="{{ path('app_intervenant_index') }}">Les ministres</a></li>
                        <li><a href="{{ path('app_media_space') }}">Espace média</a></li>
                        <li><a href="{{ path('app_about') }}">À propos</a></li>
                    </ul>
                </div>

                <div class="site-footer__social">
                    <h4>Suivez-nous</h4>
                    {# Comptes officiels du Gouvernement et de la Présidence. #}
                    {% set socialLinks = [
                        {url: 'https://facebook.com/gouvbenin', label: 'Facebook', icon: 'fa-facebook-f'},
                        {url: 'https://twitter.com/gouvbenin', label: 'X (Twitter)', icon: 'fa-x-twitter'},
                        {url: 'https://youtube.com/presidencebenin', label: 'YouTube', icon: 'fa-youtube'},
                        {url: 'https://flickr.com/presidencebenin', label: 'Flickr', icon: 'fa-flickr'},
                    ] %}
                    <div class="social-icons">
                        {% for link in socialLinks %}
                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ link.label }} (nouvel onglet)" title="{{ link.label }}"><i class="fa-brands {{ link.icon }}" aria-hidden="true"></i></a>
                        {% endfor %}
                    </div>
                    <a class="site-footer__contact" href="{{ path('app_contact') }}"><i class="fa-regular fa-envelope" aria-hidden="true"></i> Nous contacter</a>
                </div>
            </div>

            <div class="site-footer__bottom">
                <div class="wrap site-footer__bottom-inner">
                    <p>© Gouvernement de la République du Bénin - {{ "now"|date("Y") }}</p>
                    <nav>
                        <a href="{{ path('app_privacy') }}">Politique de confidentialité</a>
                        <a href="{{ path('app_legal_notice') }}">Mentions légales</a>
                    </nav>
                </div>
            </div>
        </footer>
    </body>
</html>
