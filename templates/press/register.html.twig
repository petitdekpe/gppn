{% extends 'base.html.twig' %}

{% block title %}Espace presse : inscription — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Médias et presse : créez votre compte pour accéder à l’espace média et télécharger les lots de contenus.{% endblock %}

{% block body %}
    <section class="page-header wrap">
        {{ include('partials/_back_link.html.twig', {fallback: back}) }}
        <span class="eyebrow">Espace presse et médias</span>
        <h1>Créer un compte presse / organisation</h1>
        <p>Pour accéder à l’espace média, télécharger les lots (vidéo TV, vidéo Mobile, audio MP3) et recevoir les contenus du Gouvernement.</p>
    </section>

    <section class="section wrap press-auth">
        <div class="form-card press-register">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <fieldset class="press-register__group">
                    <legend>Votre structure</legend>
                    <div class="form-grid-2">
                        {{ form_row(form.organization) }}
                        {{ form_row(form.mediaType) }}
                    </div>
                </fieldset>
                <fieldset class="press-register__group">
                    <legend>Vos coordonnées</legend>
                    <div class="form-grid-2">
                        {{ form_row(form.fullName) }}
                        {{ form_row(form.phone) }}
                    </div>
                </fieldset>
                <fieldset class="press-register__group">
                    <legend>Vos identifiants</legend>
                    {{ form_row(form.email) }}
                    <div class="form-grid-2">
                        {{ form_row(form.plainPassword.first) }}
                        {{ form_row(form.plainPassword.second) }}
                    </div>
                </fieldset>
                <div class="press-register__consent">
                    {{ form_widget(form.consent) }}
                    {{ form_label(form.consent) }}
                    {{ form_errors(form.consent) }}
                </div>
                <button type="submit" class="btn btn--primary">Créer mon compte</button>
            {{ form_end(form) }}
        </div>

        <aside class="press-auth__aside">
            <h2>Déjà inscrit ?</h2>
            <p>Connectez-vous avec votre adresse e-mail et votre mot de passe.</p>
            <a class="btn btn--dark" href="{{ path('app_press_login', {retour: back}) }}">Se connecter</a>
        </aside>
    </section>
{% endblock %}
