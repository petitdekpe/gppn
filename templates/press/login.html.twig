{% extends 'base.html.twig' %}

{% block title %}Espace presse : connexion — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Médias et presse : connectez-vous pour accéder à l’espace média et télécharger les lots de contenus.{% endblock %}

{% block body %}
    <section class="page-header wrap">
        {{ include('partials/_back_link.html.twig', {fallback: back}) }}
        <span class="eyebrow">Espace presse et médias</span>
        <h1>Connectez-vous pour télécharger</h1>
        <p>L’espace média et ses lots de contenus (vidéo TV, vidéo Mobile, audio MP3) sont réservés aux médias et à la presse. Pas encore de compte ? L’inscription prend une minute.</p>
    </section>

    <section class="section wrap press-auth">
        <div class="form-card">
            {% for message in app.flashes('error') %}
                <div class="flash flash--error"><div>{{ message }}</div></div>
            {% endfor %}
            {% if error %}
                <div class="flash flash--error"><div>{{ error.messageKey|trans(error.messageData, 'security') }}</div></div>
            {% endif %}

            {# Envoyé au contrôle de connexion commun ; en cas d'erreur, retour sur cette page. #}
            <form method="post" action="{{ path('admin_login') }}">
                <div class="form-row">
                    <label for="press-email">Adresse e-mail</label>
                    <input type="email" id="press-email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="form-row">
                    <label for="press-password">Mot de passe</label>
                    <input type="password" id="press-password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_failure_path" value="{{ path('app_press_login', {retour: back}) }}">
                <button type="submit" class="btn btn--primary">Se connecter</button>
            </form>
        </div>

        <aside class="press-auth__aside">
            <h2>Nouveau ?</h2>
            <p>Créez votre compte presse : nom, média, adresse e-mail et téléphone.</p>
            <a class="btn btn--dark" href="{{ path('app_press_register', {retour: back}) }}">S’inscrire</a>
        </aside>
    </section>
{% endblock %}
