{% extends 'base.html.twig' %}

{% block title %}Les ministres — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Retrouvez les prises de parole de chaque ministre, conseil des ministres par conseil des ministres, à télécharger et à partager.{% endblock %}

{% block body %}
    <section class="page-header wrap">
        <h1>Les ministres</h1>
        <p>Choisissez un ministre ou un ministre conseiller pour retrouver ses interventions (vidéos TV, vidéos Mobile et audios MP3), conseil des ministres par conseil des ministres, les télécharger et les transmettre en kit.</p>
    </section>

    <section class="section wrap">
        {% for group in [{title: 'Ministres', people: ministers}, {title: 'Ministres conseillers', people: councillors}] %}
            {% if group.people is not empty %}
                <h2 class="person-grid__title">{{ group.title }}</h2>
                <ul class="person-grid">
                    {% for person in group.people %}
                        <li>
                            <a class="person-card" href="{{ path('app_intervenant_show', {person: person.slug}) }}">
                                {{ include('intervenant/_photo.html.twig', {person: person, class: 'person-card__photo'}) }}
                                <span class="person-card__body">
                                    <strong>{{ person.name }}</strong>
                                    {% if person.role %}<span class="person-card__role">{{ person.role }}</span>{% endif %}
                                    <span class="person-card__count">{{ person.videoCount }} contenu{{ person.videoCount > 1 ? 's' }}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% else %}
            <p class="empty-state">Aucun contenu publié pour le moment.</p>
        {% endfor %}
    </section>
{% endblock %}
