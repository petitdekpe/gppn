<!DOCTYPE html>
<html lang="fr">
    <body style="margin:0;padding:24px;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#10192c;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;margin:0 auto;background:#ffffff;border-radius:12px;">
            <tr>
                <td style="padding:28px;">
                    <p style="margin:0 0 16px;font-size:15px;">
                        {% if purpose == 'login' %}
                            Voici votre code pour vous connecter à l’administration du site « Le Gouvernement plus près de nous » :
                        {% else %}
                            Voici votre code pour confirmer le changement de votre mot de passe :
                        {% endif %}
                    </p>
                    <p style="margin:0 0 16px;font-size:32px;font-weight:bold;letter-spacing:8px;text-align:center;">{{ code }}</p>
                    <p style="margin:0;font-size:13px;color:#5b6475;">
                        Ce code est valable {{ ttlMinutes }} minutes. Si vous n’êtes pas à l’origine de cette demande, ignorez ce message et changez votre mot de passe.
                    </p>
                </td>
            </tr>
        </table>
    </body>
</html>
