{# Un bloc par sujet : ses contenus (une langue, un intervenant chacun) côte à côte. Pages Contenus et Langue. #}
{% if results.groups is empty %}
    <p class="empty-state">Aucun contenu ne correspond à ces critères pour le moment.</p>
{% else %}
    {% for group in results.groups %}
        {% set subject = group.subject %}
        <section class="subject-group" aria-labelledby="subject-{{ subject.id }}" style="--thematic-color: {{ subject.thematic.colorHex }}">
            <header class="subject-group__header">
                <h2 id="subject-{{ subject.id }}">{{ subject.title }}</h2>
                <p class="subject-group__meta">
                    <a href="{{ path('app_thematique_show', {slug: subject.thematic.slug}) }}" class="subject-group__thematic">{{ subject.thematic.name }}</a>
                    · {{ subject.councilSession.title }}
                    · {{ group.videos|length }} contenu{{ group.videos|length > 1 ? 's' }}
                </p>
                {# Résumé commun à tous les contenus du sujet : ici une fois plutôt que sur chaque carte. #}
                {% set summary = subject.summary|striptags|trim %}
                {% if summary %}<p class="subject-group__summary">{{ summary }}</p>{% endif %}
            </header>
            <div class="video-grid">
                {% for video in group.videos %}
                    {{ include('partials/_video_card.html.twig', {video: video, cardIconActions: true, inSubject: true}) }}
                {% endfor %}
            </div>
        </section>
    {% endfor %}
    {{ include('partials/_pagination.html.twig', {results: results, route: route, route_params: route_params, label: 'Pagination des sujets'}) }}
{% endif %}
