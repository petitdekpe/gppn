{#
    Invitation faite à la presse et aux médias avant un téléchargement groupé
    (archive, lot, kit) : se connecter ou s'inscrire (e-mail et téléphone).
    Paramètre facultatif : pressGateMessage (nom préfixé : include transmet aussi les variables de la page).
#}
<div class="press-gate">
    <p>
        <i class="fa-solid fa-lock" aria-hidden="true"></i>
        {{ pressGateMessage ?? 'Presse et médias : connectez-vous ou inscrivez-vous pour télécharger le kit complet.' }}
    </p>
    <div class="press-gate__actions">
        <a class="btn btn--dark btn--sm" href="{{ path('app_press_login', {retour: app.request.requestUri}) }}">Se connecter</a>
        <a class="btn btn--outline btn--sm" href="{{ path('app_press_register', {retour: app.request.requestUri}) }}">S’inscrire</a>
    </div>
</div>
