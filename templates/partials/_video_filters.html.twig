{#
    Barre de filtres des listes de contenus (Contenus, Langue, Thématique).
    Chaque choix met à jour les résultats sans recharger la page
    (live_filters_controller.js) ; les zones data-live-region sont
    rafraîchies. Les listes longues ne montrent que les entrées les plus
    fournies (et celles cochées), le reste derrière « + N autres ».
#}
{% import _self as filters %}

{# Liste de cases à cocher, repliée au-delà de `limit` entrées. #}
{% macro options(name, items, limit, moreLabel, byCount = true) %}
    {% set ranked = byCount ? items|sort((a, b) => b.count <=> a.count) : items %}
    {% set topValues = ranked|slice(0, limit)|map(i => i.value) %}
    {% set shown = items|filter(i => i.checked or i.value in topValues) %}
    {% set folded = items|filter(i => not (i.checked or i.value in topValues)) %}
    <div class="filters-sidebar__options">
        {% for item in shown %}
            <label class="filters-sidebar__option">
                <input type="checkbox" name="{{ name }}" value="{{ item.value }}"{{ item.checked ? ' checked' }}>
                <span>{{ item.label }}</span>
                {% if item.count is not same as(null) %}<span class="filters-sidebar__option-count">{{ item.count }}</span>{% endif %}
            </label>
        {% endfor %}
    </div>
    {% if folded is not empty %}
        <details class="filters-sidebar__fold">
            <summary>+ {{ folded|length }} {{ moreLabel }}</summary>
            <div class="filters-sidebar__options">
                {% for item in folded %}
                    <label class="filters-sidebar__option">
                        <input type="checkbox" name="{{ name }}" value="{{ item.value }}">
                        <span>{{ item.label }}</span>
                        {% if item.count is not same as(null) %}<span class="filters-sidebar__option-count">{{ item.count }}</span>{% endif %}
                    </label>
                {% endfor %}
            </div>
        </details>
    {% endif %}
{% endmacro %}

{% set activeFiltersCount = (selectedThematicSlugs is defined ? selectedThematicSlugs|length : 0) + (selectedLanguageSlugs is defined ? selectedLanguageSlugs|length : 0) + (selectedFormatValues is defined ? selectedFormatValues|length : 0) + (selectedCouncilSessionSlugs is defined ? selectedCouncilSessionSlugs|length : 0)
    + (speakerPeriod is defined and speakerPeriod.hasPerson ? 1 : 0) + (speakerPeriod is defined and speakerPeriod.hasPeriod ? 1 : 0)
    + (roleLabels is defined and selectedRole != 'tous' ? 1 : 0) %}
{% set moreFiltersActive = (selectedFormatValues is defined and selectedFormatValues) or (selectedCouncilSessionSlugs is defined and selectedCouncilSessionSlugs) %}
{# Disposition « top » (page Contenus) : barre au-dessus des résultats, Intervenants et Langue visibles, le reste derrière « + Plus de filtres ». #}
{% set isTop = (layout ?? 'sidebar') == 'top' %}
{% set extraFiltersActive = moreFiltersActive or (selectedThematicSlugs is defined and selectedThematicSlugs) or (speakerPeriod is defined and (speakerPeriod.hasPerson or speakerPeriod.hasPeriod)) %}

{% set languageItems = languages is defined ? languages|filter(row => row.videoCount > 0 or (selectedLanguageSlugs is defined and row.language.slug in selectedLanguageSlugs))|map(row => {value: row.language.slug, label: row.language.name, count: row.videoCount, checked: selectedLanguageSlugs is defined and row.language.slug in selectedLanguageSlugs}) : [] %}
{% set thematicItems = thematics is defined ? thematics|filter(row => row.videoCount > 0 or (selectedThematicSlugs is defined and row.thematic.slug in selectedThematicSlugs))|map(row => {value: row.thematic.slug, label: row.thematic.name, count: row.videoCount, checked: selectedThematicSlugs is defined and row.thematic.slug in selectedThematicSlugs}) : [] %}
{% set formatItems = formats is defined ? formats|filter(format => formatCounts is not defined or (formatCounts[format.value] ?? 0) > 0 or (selectedFormatValues is defined and format.value in selectedFormatValues))|map(format => {value: format.value, label: format.label, count: formatCounts is defined ? (formatCounts[format.value] ?? 0) : null, checked: selectedFormatValues is defined and format.value in selectedFormatValues}) : [] %}
{% set councilItems = councilSessions is defined ? councilSessions|filter(row => row.videoCount > 0 or (selectedCouncilSessionSlugs is defined and row.councilSession.slug in selectedCouncilSessionSlugs))|map(row => {value: row.councilSession.slug, label: row.councilSession.label ?: 'Conseil du ' ~ row.councilSession.date|date('d/m/Y'), count: row.videoCount, checked: selectedCouncilSessionSlugs is defined and row.councilSession.slug in selectedCouncilSessionSlugs}) : [] %}

<div class="filters-panel{{ isTop ? ' filters-panel--top' }}" data-controller="filters">
    {% if not isTop %}
        <button type="button" class="filters-panel__toggle" data-action="filters#toggle" data-filters-target="toggle" aria-expanded="false" aria-controls="filters-panel-body">
            <span class="filters-panel__toggle-label">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                Filtres
                <span data-live-region="filters-count">{% if activeFiltersCount > 0 %}<span class="filters-panel__count">{{ activeFiltersCount }}</span>{% endif %}</span>
            </span>
            <svg class="filters-panel__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
    {% endif %}

    <div class="filters-panel__body" id="filters-panel-body" data-filters-target="body">
        <div class="filters-panel__head" data-live-region="filters-head">
            <span class="filters-panel__title">Filtres</span>
            {% if activeFiltersCount > 0 %}
                <a class="filters-panel__reset" data-live-link href="{{ resetUrl ?? path('app_video_index', {role: selectedRole is defined and selectedRole != 'tous' ? selectedRole : null}) }}">Réinitialiser</a>
            {% endif %}
        </div>

        <form class="filters-sidebar" action="{{ action }}" method="get" data-live-region="filters-form"
              data-controller="live-filters" data-action="change->live-filters#change submit->live-filters#submit">
            {% if query %}
                <input type="hidden" name="q" value="{{ query }}">
            {% endif %}

            {# Choix faits hors de la barre (ex. conseil des ministres de la page thématique). #}
            {% for name, value in hiddenParams ?? {} %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}

            {# Profil des intervenants : choix unique dans la barre (page Contenus), sinon conservé tel quel. #}
            {% if roleLabels is defined %}
                <fieldset class="filters-sidebar__group">
                    <legend>Intervenants</legend>
                    <div class="filters-sidebar__options">
                        {% for role, label in roleLabels %}
                            <label class="filters-sidebar__option">
                                <input type="radio" name="role" value="{{ role == 'tous' ? '' : role }}"{{ role == selectedRole ? ' checked' }}>
                                <span>{{ label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            {% elseif selectedRole is defined and selectedRole and selectedRole != 'tous' %}
                <input type="hidden" name="role" value="{{ selectedRole }}">
            {% endif %}

            {% if languageItems is not empty %}
                <fieldset class="filters-sidebar__group">
                    <legend>Langue</legend>
                    {{ filters.options('langue[]', languageItems, 8, 'autres langues') }}
                </fieldset>
            {% endif %}

            {# Disposition « top » : tous les autres filtres dans un seul volet. #}
            {% if isTop %}
                <details class="filters-sidebar__more filters-sidebar__extra"{{ extraFiltersActive ? ' open' }}>
                    <summary class="filters-sidebar__more-summary">Plus de filtres</summary>
                    <div class="filters-sidebar__more-body">
            {% endif %}

            {% if thematicItems is not empty %}
                <fieldset class="filters-sidebar__group">
                    <legend>Thématique</legend>
                    {{ filters.options('thematique[]', thematicItems, 8, 'autres thématiques') }}
                </fieldset>
            {% endif %}

            {# Filtres facultatifs, repliés tant qu'ils ne servent pas. #}
            {% if people is defined and people is not empty %}
                <details class="filters-sidebar__more"{{ speakerPeriod.hasPerson ? ' open' }}>
                    <summary class="filters-sidebar__more-summary">
                        Intervenant <span class="filters-sidebar__optional">facultatif</span>
                        {% if speakerPeriod.hasPerson %}<span class="filters-sidebar__active">{{ speakerPeriod.personName }}</span>{% endif %}
                    </summary>
                    <div class="filters-sidebar__more-body">
                        <label class="sr-only" for="filter-person">Intervenant</label>
                        <select id="filter-person" name="intervenant" class="filters-sidebar__select">
                            <option value="">Tous les intervenants</option>
                            {% for group, label in {ministre: 'Ministres', conseiller: 'Ministres conseillers'} %}
                                {% set members = people|filter(p => p.councillor == (group == 'conseiller')) %}
                                {% if members is not empty %}
                                    <optgroup label="{{ label }}">
                                        {% for person in members %}
                                            <option value="{{ person.slug }}"{{ person.slug == speakerPeriod.person ? ' selected' }}>{{ person.name }} ({{ person.videoCount }})</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endif %}
                            {% endfor %}
                        </select>
                        <p class="filters-sidebar__hint">Toutes ses prises de parole, y compris dans les gouvernements précédents.</p>
                    </div>
                </details>
            {% endif %}

            {% if speakerPeriod is defined %}
                <details class="filters-sidebar__more"{{ speakerPeriod.hasPeriod ? ' open' }}>
                    <summary class="filters-sidebar__more-summary">
                        Période <span class="filters-sidebar__optional">facultatif</span>
                        {% if speakerPeriod.hasPeriod %}<span class="filters-sidebar__active">{{ speakerPeriod.periodLabel }}</span>{% endif %}
                    </summary>
                    <div class="filters-sidebar__more-body">
                        <div class="filters-sidebar__dates">
                            <label>Du <input type="date" name="du" value="{{ speakerPeriod.from ? speakerPeriod.from|date('Y-m-d') }}"></label>
                            <label>Au <input type="date" name="au" value="{{ speakerPeriod.to ? speakerPeriod.to|date('Y-m-d') }}"></label>
                        </div>
                        {% if periodShortcuts is defined and periodShortcuts is not empty %}
                            <div class="filters-sidebar__shortcuts">
                                {% set currentPeriod = (speakerPeriod.from ? speakerPeriod.from|date('Y-m-d')) ~ '|' ~ (speakerPeriod.to ? speakerPeriod.to|date('Y-m-d')) %}
                                {% for shortcut in periodShortcuts %}
                                    <button type="submit" name="periode" value="{{ shortcut.value }}" class="filters-sidebar__shortcut{{ shortcut.value == currentPeriod ? ' is-active' }}">{{ shortcut.label }}</button>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if speakerPeriod.hasPeriod %}
                            <button type="submit" name="periode" value="clear" class="filters-sidebar__clear">Toutes les dates</button>
                        {% endif %}
                        <p class="filters-sidebar__hint">D’après la date du conseil des ministres.</p>
                    </div>
                </details>
            {% endif %}

            {# Volet propre à la barre latérale ; en disposition « top », déjà dans « Plus de filtres ». #}
            {% if formatItems is not empty or councilItems is not empty %}
                {% if not isTop %}
                <details class="filters-sidebar__more"{{ moreFiltersActive ? ' open' }}>
                    <summary class="filters-sidebar__more-summary">Plus de filtres</summary>
                    <div class="filters-sidebar__more-body">
                {% endif %}
                        {% if formatItems is not empty %}
                            <fieldset class="filters-sidebar__group">
                                <legend>Format</legend>
                                {{ filters.options('format[]', formatItems, 10, 'autres formats', false) }}
                            </fieldset>
                        {% endif %}

                        {% if councilItems is not empty %}
                            <fieldset class="filters-sidebar__group">
                                <legend>Conseil des ministres</legend>
                                {# Les plus récents ; les autres derrière « + N ». #}
                                {{ filters.options('conseil[]', councilItems, 5, 'conseils plus anciens', false) }}
                            </fieldset>
                        {% endif %}
                {% if not isTop %}
                    </div>
                </details>
                {% endif %}
            {% endif %}

            {% if isTop %}
                    </div>
                </details>
            {% endif %}

            {# Mobile : referme le panneau et montre les résultats (déjà à jour). Sans JavaScript, envoie les choix. #}
            {% if resultsTotal is defined and not isTop %}
                <button type="submit" class="filters-sidebar__submit" data-live-filters-close>Voir {{ resultsTotal }} capsule{{ resultsTotal > 1 ? 's' : '' }}</button>
            {% endif %}
            <noscript><button type="submit" class="btn btn--dark btn--sm">Appliquer les filtres</button></noscript>
        </form>
    </div>
</div>
