{% set formatIcons = {video: '▶', audio: '♪', pdf: '📄', image: '🖼'} %}
{% set previewFile = video.primaryPlaybackFile %}
{% set previewCategory = previewFile ? previewFile.type.medium : null %}
{% set coverImageUrl = video_cover_url(video) %}
<article class="video-card" style="--thematic-color: {{ video.thematic.colorHex }}">
    <a href="{{ path('app_video_show', {slug: video.slug}) }}" class="video-card__thumb"{% if inSubject ?? false %} aria-label="Voir « {{ video.title }} » en {{ video.language.name }}{{ video.speaker ? ', par ' ~ video.speaker.fullName }}"{% endif %}>
        {% if previewFile %}
            <span class="video-card__format-tag">{{ previewFile.type.category.label }}</span>
        {% endif %}
        {% if previewCategory in ['video', 'audio'] %}
            <span class="video-card__duration">{{ video.durationLabel }}</span>
        {% endif %}
        {% if coverImageUrl %}
            <img class="video-card__preview" src="{{ coverImageUrl }}" alt="">
        {% elseif previewCategory == 'video' %}
            <video class="video-card__preview" muted preload="metadata" playsinline>
                {{ include('partials/_video_sources.html.twig', {file: previewFile}) }}
            </video>
        {% elseif previewCategory == 'image' %}
            <img class="video-card__preview" src="{{ video_file_url(previewFile) }}" alt="">
        {% else %}
            <span class="video-card__play" aria-hidden="true">{{ formatIcons[previewCategory] ?? '▶' }}</span>
        {% endif %}
    </a>
    <div class="video-card__body">
        {# inSubject (blocs par sujet) : thématique, titre et résumé sont déjà dans l'en-tête du sujet ;
           la carte montre en quelle langue, puis qui parle (nom et sigle). #}
        {% if inSubject ?? false %}
            <p class="video-card__language">{{ video.language.name }}</p>
            {% if video.speaker %}
                <h3 class="video-card__speaker">
                    <a href="{{ path('app_intervenant_show', {person: video.speaker.personSlug}) }}">{{ video.speaker.fullName }}</a>
                    {% set sigle = speaker_sigle(video.speaker) %}
                    {% if sigle %}<span class="video-card__sigle">{{ sigle }}</span>{% endif %}
                </h3>
            {% endif %}
        {% else %}
            <a href="{{ path('app_thematique_show', {slug: video.thematic.slug}) }}" class="video-card__thematic" style="color: {{ video.thematic.colorHex }}">{{ video.thematic.name|upper }}</a>
            <h3 class="video-card__title"><a href="{{ path('app_video_show', {slug: video.slug}) }}">{{ video.title }}</a></h3>
            {% set summary = video.summary|striptags|trim %}
            {% if summary %}
                <p class="video-card__summary">{{ summary|slice(0, 110) }}{{ summary|length > 110 ? '…' }}</p>
            {% endif %}
        {% endif %}
        <p class="video-card__meta">{{ video.publishedAt|date_fr }} · {{ video.viewsCount|number_format(0, ',', ' ') }} vue{{ video.viewsCount > 1 ? 's' }}</p>
        <div class="video-card__badges">
            {% if not (inSubject ?? false) %}
                <span class="video-card__badge">{{ video.language.name }}</span>
            {% endif %}
            {% for format in video.availableFormats %}
                <span class="video-card__badge video-card__badge--format">{{ format.label }}</span>
            {% endfor %}
            {# cardIconActions (page Contenus) : Télécharger et Partager en boutons ronds, icône seule. #}
            {% if cardIconActions ?? false %}
                <span class="video-card__actions">
                    {% set cardDownload = preferred_download(video) %}
                    {% if cardDownload %}
                        <a class="video-card__icon-btn {{ download_class(cardDownload) }}" href="{{ video_file_url(cardDownload) }}" download="{{ cardDownload.originalName ?? cardDownload.fileName }}"
                           title="Télécharger" aria-label="Télécharger « {{ video.title }} » ({{ video.language.name }})">
                            <i class="fa-solid fa-download" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    {{ include('partials/_share.html.twig', {video: video, variant: 'card', shareIconOnly: true}) }}
                </span>
            {% else %}
                {{ include('partials/_share.html.twig', {video: video, variant: 'card'}) }}
            {% endif %}
        </div>
    </div>
</article>
