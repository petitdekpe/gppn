{# Pages d'erreur : rechercher un contenu, ou repartir d'une langue. #}
<form class="error-page__search" action="{{ path('app_video_index') }}" method="get" role="search">
    <label class="sr-only" for="error-search-input">Rechercher un contenu</label>
    <input id="error-search-input" type="search" name="q" placeholder="Rechercher un sujet, un ministre…" autocomplete="off">
    <button type="submit" class="btn btn--primary" aria-label="Rechercher">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="error-page__search-label">Rechercher</span>
    </button>
</form>

{% set errorLanguages = popular_languages(8) %}
{% if errorLanguages is not empty %}
    <nav class="error-page__languages" aria-labelledby="error-languages-title">
        <h2 id="error-languages-title">Ou choisissez une langue</h2>
        <div class="home2-lang-grid">
            {% for language in errorLanguages %}
                <a href="{{ path('app_langue_show', {slug: language.slug}) }}" class="home2-lang-pill">
                    <span>{{ language.name }}</span>
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>
            {% endfor %}
        </div>
    </nav>
{% endif %}
