{# Sources d'un <video> : la version WebM générée pour la lecture en priorité,
   l'original (fichier téléchargeable) en repli tant qu'elle n'est pas prête
   ou si le navigateur ne lit pas le WebM. L'échec de la dernière source
   (aucune n'a pu être lue) est signalé au serveur (assets/playback_report.js). #}
{% set webmUrl = video_webm_url(file) %}
{% if webmUrl %}
    <source src="{{ webmUrl }}" type="video/webm">
{% endif %}
<source src="{{ video_file_url(file) }}" type="{{ file.mimeType ?? 'video/mp4' }}"{% if file.id %} data-playback-report="{{ path('app_video_file_playback_error', {id: file.id}) }}"{% endif %}>
