{% if featuredVideos is not empty %}
    <section class="section wrap">
        <div class="section__header">
            <h2>À la une cette semaine</h2>
        </div>
        <div class="spotlight" data-controller="carousel">
            {% for spotlight in featuredVideos %}
                {% set slideIndex = loop.index0 %}
                <div class="spotlight__slide{{ loop.first ? ' is-active' }}" data-carousel-target="slide">
                    {% set previewFile = spotlight.primaryPlaybackFile %}
                    {% set previewCategory = previewFile ? previewFile.type.category.value : null %}
                    {% set coverImageUrl = video_cover_url(spotlight) %}
                    <a href="{{ path('app_video_show', {slug: spotlight.slug}) }}" class="spotlight__media" style="--thematic-color: {{ spotlight.thematic.colorHex }}">
                        <span class="video-card__lang-tag">{{ spotlight.language.name }}</span>
                        {% if coverImageUrl %}
                            <img class="video-card__preview" src="{{ coverImageUrl }}" alt="">
                        {% elseif previewCategory == 'video' %}
                            <video class="video-card__preview" muted preload="metadata" playsinline>
                                {{ include('partials/_video_sources.html.twig', {file: previewFile}) }}
                            </video>
                        {% elseif previewCategory == 'image' %}
                            <img class="video-card__preview" src="{{ video_file_url(previewFile) }}" alt="">
                        {% else %}
                            <span class="video-card__play" aria-hidden="true">▶</span>
                        {% endif %}
                    </a>
                    {% if featuredVideos|length > 1 %}
                        <div class="spotlight__dots">
                            {% for other in featuredVideos %}
                                <button type="button" class="spotlight__dot{{ loop.index0 == slideIndex ? ' is-active' }}" data-action="carousel#go" data-carousel-index-param="{{ loop.index0 }}" aria-label="Voir le contenu {{ loop.index }}"></button>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="spotlight__body">
                        <span class="video-card__thematic" style="color: {{ spotlight.thematic.colorHex }}">{{ spotlight.thematic.name|upper }}</span>
                        <h3>
                            <a href="{{ path('app_video_show', {slug: spotlight.slug}) }}">{{ spotlight.title }}</a>
                        </h3>
                        <p>{{ spotlight.summary }}</p>
                        <div class="spotlight__actions">
                            {# Version Mobile en priorité (masqué sur téléphone s'il n'y en a pas). #}
                            {% set spotlightDownload = preferred_download(spotlight) %}
                            {% if spotlightDownload %}
                                <a class="btn btn--dark {{ download_class(spotlightDownload) }}" href="{{ video_file_url(spotlightDownload) }}" download="{{ spotlightDownload.originalName ?? spotlightDownload.fileName }}">Télécharger</a>
                            {% endif %}
                            {{ include('partials/_share.html.twig', {video: spotlight, variant: 'spotlight'}) }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% endif %}
