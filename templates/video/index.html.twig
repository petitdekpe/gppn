{% extends 'base.html.twig' %}

{% block title %}Tous les contenus — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Parcourez tous les contenus du programme, filtrables par thématique, par langue nationale ou par mot-clé.{% endblock %}

{% block body %}
    {% set roleLabels = {tous: 'Tous les Ministres', ministre: 'Ministres', conseiller: 'Ministres conseillés'} %}

    <nav class="view-tabs wrap" aria-label="Vue des contenus">
        {% for role, label in roleLabels %}
            {% if role == selectedRole %}
                <span class="view-tabs__item is-active" aria-current="page">{{ label }}</span>
            {% else %}
                <a class="view-tabs__item" href="{{ path('app_video_index', routeParams|merge({role: role == 'tous' ? null : role})) }}">{{ label }}</a>
            {% endif %}
        {% endfor %}
    </nav>

    <section class="section wrap video-layout">
        <aside class="video-layout__sidebar">
            {{ include('partials/_video_filters.html.twig', {
                action: path('app_video_index'),
                thematics: thematics,
                languages: languages,
                formats: formats,
                selectedThematicSlugs: selectedThematicSlugs,
                selectedLanguageSlugs: selectedLanguageSlugs,
                selectedFormatValues: selectedFormatValues,
                query: query,
                selectedRole: selectedRole,
            }) }}
        </aside>

        <div class="video-layout__main">
            <div class="page-header">
                <h1>{{ roleLabels[selectedRole] }}</h1>
                <p>{{ results.total }} contenu{{ results.total > 1 ? 's' : '' }} disponible{{ results.total > 1 ? 's' : '' }}.</p>
            </div>

            {{ include('partials/_video_grid.html.twig', {
                results: results,
                route: 'app_video_index',
                route_params: routeParams,
            }) }}
        </div>
    </section>

    {{ include('partials/_spotlight.html.twig', {featuredVideos: featuredVideos}) }}
{% endblock %}
