{% extends 'base.html.twig' %}

{% block title %}Tous les contenus — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Parcourez tous les contenus du programme, filtrables par thématique, par langue nationale ou par mot-clé.{% endblock %}

{% block body %}
    {% set roleLabels = {tous: 'Tous les contenus', ministre: 'Ministres', conseiller: 'Ministres conseillers'} %}

    {# Filtres en haut (Intervenants et Langue visibles, le reste sous « + Plus de filtres »), contenus en dessous. #}
    <section class="section wrap video-layout video-layout--stacked">
        <aside class="video-layout__sidebar">
            {{ include('partials/_video_filters.html.twig', {
                action: path('app_video_index'),
                thematics: thematics,
                languages: languages,
                formats: formats,
                formatCounts: formatCounts,
                councilSessions: councilSessions,
                selectedThematicSlugs: selectedThematicSlugs,
                selectedLanguageSlugs: selectedLanguageSlugs,
                selectedFormatValues: selectedFormatValues,
                selectedCouncilSessionSlugs: selectedCouncilSessionSlugs,
                query: query,
                selectedRole: selectedRole,
                layout: 'top',
                roleLabels: roleLabels,
                resetUrl: resetUrl,
                people: people,
                periodShortcuts: periodShortcuts,
                speakerPeriod: speakerPeriod,
                resultsTotal: results.videoTotal,
            }) }}
        </aside>

        {# Résultats rafraîchis sur place à chaque choix de filtre (live_filters_controller.js). #}
        <div class="video-layout__main" data-live-region="results">
            <div class="page-header">
                <h1>{{ roleLabels[selectedRole] }}</h1>
                <p>{{ results.videoTotal }} capsule{{ results.videoTotal > 1 ? 's' : '' }} disponible{{ results.videoTotal > 1 ? 's' : '' }}{% if results.total > 0 %}, {{ results.total }} sujet{{ results.total > 1 ? 's' : '' }}{% endif %}.</p>
            </div>

            {{ include('partials/_active_filters.html.twig', {activeFilters: activeFilters, resetUrl: resetUrl}) }}

            {# Recherche qui désigne un intervenant : sa page en premier. #}
            {% for person in matchedPeople %}
                <a class="person-match" href="{{ path('app_intervenant_show', {person: person.slug}) }}">
                    <span class="person-match__icon" aria-hidden="true"><i class="fa-solid fa-user-tie"></i></span>
                    <span class="person-match__info">
                        <strong>{{ person.name }}</strong>
                        {% if person.role %}<span class="muted">{{ person.role }}</span>{% endif %}
                    </span>
                    <span class="person-match__cta">Voir sa page · {{ person.videoCount }} contenu{{ person.videoCount > 1 ? 's' }} et ses kits →</span>
                </a>
            {% endfor %}

            {# Un bloc par sujet : ses contenus (une langue, un intervenant chacun) côte à côte. #}
            {% if results.groups is empty %}
                <p class="empty-state">Aucun contenu ne correspond à ces critères pour le moment.</p>
            {% else %}
                {% for group in results.groups %}
                    {% set subject = group.subject %}
                    <section class="subject-group" aria-labelledby="subject-{{ subject.id }}" style="--thematic-color: {{ subject.thematic.colorHex }}">
                        <header class="subject-group__header">
                            <h2 id="subject-{{ subject.id }}">{{ subject.title }}</h2>
                            <p class="subject-group__meta">
                                <a href="{{ path('app_thematique_show', {slug: subject.thematic.slug}) }}" class="subject-group__thematic">{{ subject.thematic.name }}</a>
                                · Conseil du {{ subject.councilSession.date|date('d/m/Y') }}
                                · {{ group.videos|length }} contenu{{ group.videos|length > 1 ? 's' }}
                            </p>
                        </header>
                        <div class="video-grid">
                            {% for video in group.videos %}
                                {{ include('partials/_video_card.html.twig', {video: video, cardIconActions: true}) }}
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
                {{ include('partials/_pagination.html.twig', {results: results, route: 'app_video_index', route_params: routeParams, label: 'Pagination des sujets'}) }}
            {% endif %}
        </div>
    </section>

    {{ include('partials/_spotlight.html.twig', {featuredVideos: featuredVideos}) }}
{% endblock %}
