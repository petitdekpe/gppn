{% extends 'base.html.twig' %}

{% block title %}{{ video.title }} — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}{{ video.summary|striptags|slice(0, 150) }}{% endblock %}

{% block body %}
    <section class="wrap video-detail">
        {{ include('partials/_back_link.html.twig', {fallback: path('app_video_index')}) }}

        <nav class="breadcrumb" aria-label="Fil d’Ariane">
            <a href="{{ path('app_home') }}">Accueil</a> ›
            <a href="{{ path('app_video_index') }}">Contenus</a> ›
            <a href="{{ path('app_thematique_show', {slug: video.thematic.slug}) }}">{{ video.thematic.name }}</a>
        </nav>

        {% set playbackFile = video.primaryPlaybackFile %}
        {% set playbackUrl = playbackFile ? video_file_url(playbackFile) : null %}
        {% set playbackCategory = playbackFile ? playbackFile.type.category.value : null %}
        {% set availableFiles = video.files|filter(f => f.fileName is not null) %}
        <div class="video-detail__content">
            <div class="video-detail__top">
                {% if playbackCategory == 'audio' %}
                    <div class="video-detail__player video-detail__player--audio" style="--thematic-color: {{ video.thematic.colorHex }}">
                        <span class="video-card__lang-tag">{{ video.language.name }}</span>
                        <span class="video-detail__format-icon" aria-hidden="true">♪</span>
                        <audio class="video-detail__audio" controls src="{{ playbackUrl }}"></audio>
                    </div>
                {% elseif playbackCategory == 'image' %}
                    <div class="video-detail__player video-detail__player--image" style="--thematic-color: {{ video.thematic.colorHex }}; --cover-position: {{ video.coverPositionX }}% {{ video.coverPositionY }}%">
                        <span class="video-card__lang-tag">{{ video.language.name }}</span>
                        <img src="{{ playbackUrl }}" alt="{{ video.title }}">
                    </div>
                {% elseif playbackCategory == 'pdf' %}
                    <div class="video-detail__player video-detail__player--pdf" style="--thematic-color: {{ video.thematic.colorHex }}">
                        <span class="video-card__lang-tag">{{ video.language.name }}</span>
                        <iframe class="video-detail__pdf" src="{{ playbackUrl }}" title="{{ video.title }}"></iframe>
                    </div>
                {% elseif playbackCategory == 'video' %}
                    <div class="video-detail__player" style="--thematic-color: {{ video.thematic.colorHex }}">
                        <video class="video-detail__video" controls preload="metadata">
                            <source src="{{ playbackUrl }}" type="{{ playbackFile.mimeType ?? 'video/mp4' }}">
                        </video>
                    </div>
                {% else %}
                    <div class="video-detail__player" style="--thematic-color: {{ video.thematic.colorHex }}">
                        <span class="video-card__lang-tag">{{ video.language.name }}</span>
                        <span class="video-card__play video-card__play--lg" aria-hidden="true">▶</span>
                    </div>
                {% endif %}

                <aside class="download-panel">
                    <h2>Télécharger</h2>
                    <p class="muted">Libre de droits pour rediffusion.<br>Aucun compte requis.</p>

                    {% if availableFiles is not empty %}
                        <ul class="download-list">
                            {% for file in availableFiles %}
                                <li>
                                    <span class="download-list__badge">{{ file.type.badge }}</span>
                                    <span class="download-list__info">
                                        <strong>{{ file.type.label }}</strong>
                                        <span class="muted">{{ file.type.description }}</span>
                                    </span>
                                    <span class="download-list__size">{{ (file.fileSize / 1048576)|round(1) }} Mo</span>
                                    <a href="{{ video_file_url(file) }}" download="{{ file.originalName ?? file.fileName }}" class="btn btn--outline btn--sm">Télécharger</a>
                                </li>
                            {% endfor %}
                        </ul>

                        {% if availableFiles|length > 1 %}
                            <a href="{{ path('app_video_download_all', {slug: video.slug}) }}" class="btn btn--dark download-panel__all">Tout télécharger (.zip)</a>
                        {% endif %}
                    {% else %}
                        <p class="muted">Aucun fichier disponible pour le moment.</p>
                    {% endif %}

                    <p class="download-panel__mention">Mention obligatoire à la diffusion : « Le Gouvernement Plus Près de Nous - République du Bénin. »</p>
                </aside>
            </div>

            <div class="video-detail__main">
                <div class="video-detail__tags">
                    <span class="video-card__lang-tag video-card__lang-tag--static">{{ video.language.name }}</span>
                    <a href="{{ path('app_thematique_show', {slug: video.thematic.slug}) }}" class="video-card__thematic" style="color: {{ video.thematic.colorHex }}">{{ video.thematic.name|upper }}</a>
                </div>

                <h1>{{ video.title }}</h1>
                <p class="video-card__meta">Publiée le {{ video.publishedAt|date('d F Y') }} · <strong>{{ video.viewsCount|number_format(0, ',', ' ') }} vues</strong></p>
                <p class="video-detail__summary">{{ video.summary }}</p>

                {% set learningPoints = video.learningPointsList %}
                {% if learningPoints is not empty %}
                    <div class="info-box">
                        <h2>Ce que vous apprendrez dans ce contenu</h2>
                        <ul>
                            {% for point in learningPoints %}
                                <li>{{ point }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if video.speaker is not null %}
                    <div class="video-detail__speakers">
                        <h2>Intervenant</h2>
                        <ul>
                            <li>
                                <strong>{{ video.speaker.fullName }}</strong>
                                {% if video.speaker.role %}<span class="muted"> — {{ video.speaker.role }}</span>{% endif %}
                            </li>
                        </ul>
                    </div>
                {% endif %}

                <div class="info-box feedback-box">
                    <h2>Ce contenu vous a-t-il été utile ?</h2>
                    <p class="muted">Votre réaction nous aide à améliorer la traduction et la clarté des prochains contenus.</p>

                    <form action="{{ path('app_video_feedback', {slug: video.slug}) }}" method="post" class="feedback-form" data-controller="feedback">
                        <input type="hidden" name="_token" value="{{ csrf_token('video_feedback_' ~ video.id) }}">
                        <input type="hidden" name="rating" data-feedback-target="rating">

                        <div class="feedback-form__choices">
                            <button type="button" class="btn btn--outline btn--sm" data-feedback-target="choice" data-action="feedback#choose" data-feedback-rating-param="clear">Oui, c’est clair</button>
                            <button type="button" class="btn btn--outline btn--sm" data-feedback-target="choice" data-action="feedback#choose" data-feedback-rating-param="unclear">Pas très clair</button>
                            <button type="button" class="btn btn--outline btn--sm" data-feedback-target="choice" data-action="feedback#choose" data-feedback-rating-param="not_clear">Non, pas clair</button>
                        </div>

                        <label class="sr-only" for="feedback-comment">Votre commentaire</label>
                        <textarea id="feedback-comment" name="comment" rows="3" placeholder="Dites-nous en plus (facultatif) : un mot mal traduit, un point à préciser…"></textarea>

                        <button type="submit" class="btn btn--dark">Envoyer</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {% if relatedVideos is not empty %}
        <section class="section wrap">
            <div class="section__header">
                <h2>Contenus similaires</h2>
            </div>
            <div class="video-grid">
                {% for related in relatedVideos %}
                    {{ include('partials/_video_card.html.twig', {video: related}) }}
                {% endfor %}
            </div>
            <div class="section__more">
                <a class="btn btn--dark" href="{{ path('app_thematique_show', {slug: video.thematic.slug}) }}">Afficher plus</a>
            </div>
        </section>
    {% endif %}
{% endblock %}
