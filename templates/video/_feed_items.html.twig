{% for video in videos %}
    {% set verticalFile = video.verticalFile %}
    {% if verticalFile %}
        <article class="feed-item" data-feed-target="item" style="--thematic-color: {{ video.thematic.colorHex }}">
            <video class="feed-item__video" data-feed-target="video" data-action="click->feed#togglePlay" muted loop playsinline preload="metadata">
                {{ include('partials/_video_sources.html.twig', {file: verticalFile}) }}
            </video>

            <button type="button" class="feed-item__sound" data-action="feed#toggleMute" aria-label="Activer le son">
                <i class="fa-solid fa-volume-xmark" aria-hidden="true"></i>
            </button>

            <div class="feed-item__overlay">
                {# Actions flottantes à droite de la vidéo, au-dessus du bandeau. #}
                <div class="feed-item__actions">
                    {{ include('partials/_share.html.twig', {video: video, variant: 'feed'}) }}
                    <a href="{{ video_file_url(verticalFile) }}" download="{{ verticalFile.originalName ?? verticalFile.fileName }}" class="feed-item__action" aria-label="Télécharger « {{ video.title }} » (version Mobile{% if verticalFile.fileSize %}, {{ (verticalFile.fileSize / 1048576)|round(1) }} Mo{% endif %})">
                        <span class="feed-item__action-icon"><i class="fa-solid fa-download" aria-hidden="true"></i></span>
                        <span class="feed-item__action-label">Télécharger</span>
                    </a>
                </div>

                <div class="feed-item__info">
                    <div class="feed-item__tags">
                        <span class="video-card__lang-tag video-card__lang-tag--static">{{ video.language.name }}</span>
                        <a href="{{ path('app_thematique_show', {slug: video.thematic.slug}) }}" class="video-card__thematic" style="color: {{ video.thematic.colorHex }}">{{ video.thematic.name|upper }}</a>
                    </div>
                    <h2 class="feed-item__title">{{ video.title }}</h2>
                    <p class="feed-item__meta">{{ video.viewsCount|number_format(0, ',', ' ') }} vues</p>
                </div>

                <a href="{{ path('app_video_show', {slug: video.slug}) }}" class="btn btn--dark btn--sm feed-item__download">Voir la fiche</a>
            </div>
        </article>
    {% endif %}
{% endfor %}
