{% extends 'base.html.twig' %}

{% block title %}Vidéos Mobile | Le Gouvernement plus près de nous{% endblock %}

{% block body %}
    <div class="feed"
         data-controller="feed"
         data-feed-more-url-value="{{ path('app_video_feed_more') }}"
         data-feed-next-page-value="{{ nextPage }}"
         data-feed-has-more-value="{{ hasMore ? '1' : '0' }}">
        <a href="{{ path('app_home') }}" class="feed__close" aria-label="Fermer le fil des vidéos Mobile">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </a>

        {% if videos is empty %}
            <p class="feed__empty">Aucune vidéo Mobile pour le moment.</p>
        {% else %}
            <div class="feed__scroller" data-feed-target="scroller">
                {% include 'video/_feed_items.html.twig' with {videos: videos} only %}

                {% if hasMore %}
                    <div class="feed__sentinel" data-feed-target="sentinel"></div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
