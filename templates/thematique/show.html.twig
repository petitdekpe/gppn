{% extends 'base.html.twig' %}

{% block title %}{{ thematic.name }} — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Tous les contenus du Gouvernement sur la thématique {{ thematic.name }}, dans vos langues nationales.{% endblock %}

{% block body %}
    {% set councilLabel = selectedCouncil ? (selectedCouncil.label ?: 'Conseil des ministres du ' ~ selectedCouncil.date|date('d/m/Y')) : null %}

    <section class="page-header wrap page-header--tinted" style="--thematic-color: {{ thematic.colorHex }}">
        {{ include('partials/_back_link.html.twig', {fallback: path('app_thematique_index')}) }}
        <span class="eyebrow">Thématique</span>
        <h1>{{ thematic.name }}</h1>
        <p data-live-region="results-count">{{ results.total }} capsule{{ results.total > 1 ? 's' : '' }} sur cette thématique{{ councilLabel ? ' · ' ~ councilLabel }}.</p>
    </section>

    <section class="section wrap video-layout">
        <aside class="video-layout__sidebar">
            {{ include('partials/_video_filters.html.twig', {
                action: path('app_thematique_show', {slug: thematic.slug}),
                languages: languages,
                formats: formats,
                selectedLanguageSlugs: selectedLanguageSlugs,
                selectedFormatValues: selectedFormatValues,
                query: query,
                hiddenParams: selectedCouncil ? {conseil: selectedCouncil.slug} : {},
                resetUrl: path('app_thematique_show', {slug: thematic.slug}),
            }) }}
        </aside>

        <div class="video-layout__main" data-live-region="results">
            {% if councilOptions|length > 1 or selectedCouncil %}
                {# Tous les conseils, ou un seul : garde les autres filtres (langues, formats, recherche). #}
                <form method="get" action="{{ path('app_thematique_show', {slug: thematic.slug}) }}" class="council-filter"
                      data-controller="live-filters" data-action="change->live-filters#change submit->live-filters#submit">
                    {% for name, value in routeParams|filter((v, k) => k != 'conseil') %}
                        {% for item in value is iterable ? value : [value] %}
                            <input type="hidden" name="{{ name }}{{ value is iterable ? '[]' }}" value="{{ item }}">
                        {% endfor %}
                    {% endfor %}
                    <label for="council-filter">Conseil des ministres</label>
                    <select id="council-filter" name="conseil">
                        <option value="">Tous les conseils ({{ councilOptions|reduce((sum, row) => sum + row.videoCount, 0) }})</option>
                        {% for row in councilOptions %}
                            {% set council = row.councilSession %}
                            <option value="{{ council.slug }}"{{ council == selectedCouncil ? ' selected' }}>
                                {{ council.label ?: 'Conseil du ' ~ council.date|date('d/m/Y') }} ({{ row.videoCount }})
                            </option>
                        {% endfor %}
                    </select>
                    <noscript><button type="submit" class="btn btn--outline btn--sm">Afficher</button></noscript>
                </form>
            {% endif %}

            {{ include('partials/_video_grid.html.twig', {
                results: results,
                route: 'app_thematique_show',
                route_params: routeParams|merge({slug: thematic.slug}),
            }) }}
        </div>
    </section>
{% endblock %}
