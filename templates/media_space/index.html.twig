{% extends 'base.html.twig' %}

{% block title %}Préparez un lot de capsules à diffuser — Le Gouvernement plus près de nous{% endblock %}
{% block meta_description %}Composez un lot de capsules par sujet, langue et format, puis téléchargez-le en une seule archive prête à diffuser.{% endblock %}

{% block body %}
    <section class="page-header wrap page-header--dark">
        {{ include('partials/_back_link.html.twig', {fallback: path('app_home')}) }}
        <span class="eyebrow">Espace média &amp; institutions</span>
        <h1>Préparez un lot de capsules à diffuser</h1>
        <p>Composez votre lot par sujet, langue et format, puis téléchargez-le en une seule archive. Il s’adresse aussi bien au réseau média (Dircom, Maison des médias, médias partenaires) qu’aux partenaires institutionnels (ministères, préfectures, mairies).</p>
    </section>

    <section class="section wrap">
        <div class="lot-builder">
            <form method="get" action="{{ path('app_media_space') }}" class="lot-builder__steps">
                {# Raccourci facultatif, replié : toutes les vidéos d'un intervenant et/ou d'une période.
                   Sans sujet coché, il compose le lot à lui seul ; avec des sujets cochés, il les restreint. #}
                <details class="lot-builder__step lot-builder__optional"{{ speakerPeriod.isActive ? ' open' }}>
                    <summary>
                        <span class="lot-builder__optional-title">Raccourci : toutes les vidéos d’un intervenant ou d’une période</span>
                        <span class="lot-builder__optional-tag">facultatif</span>
                        {% if speakerPeriod.isActive %}
                            <span class="lot-builder__optional-active">
                                {{ speakerPeriod.hasPerson ? speakerPeriod.personName }}{{ speakerPeriod.hasPerson and speakerPeriod.hasPeriod ? ' · ' }}{{ speakerPeriod.periodLabel }}
                            </span>
                        {% endif %}
                    </summary>

                    <div class="lot-builder__optional-body">
                        <details class="lot-builder__sub"{{ speakerPeriod.hasPerson ? ' open' }}>
                            <summary>Intervenant</summary>
                            <label class="sr-only" for="lot-person">Intervenant</label>
                            <select id="lot-person" name="intervenant" class="filters-sidebar__select" onchange="this.form.submit()">
                                <option value="">Tous les intervenants</option>
                                {% for person in people %}
                                    <option value="{{ person.slug }}"{{ person.slug == speakerPeriod.person ? ' selected' }}>{{ person.name }}{{ person.role ? ' — ' ~ person.role }} ({{ person.videoCount }})</option>
                                {% endfor %}
                            </select>
                            <p class="muted lot-builder__hint">Toutes ses prises de parole, y compris dans les gouvernements précédents.</p>
                        </details>

                        <details class="lot-builder__sub"{{ speakerPeriod.hasPeriod ? ' open' }}>
                            <summary>Période</summary>
                            <div class="filters-sidebar__dates">
                                <label>Du <input type="date" name="du" value="{{ speakerPeriod.from ? speakerPeriod.from|date('Y-m-d') }}" onchange="this.form.submit()"></label>
                                <label>Au <input type="date" name="au" value="{{ speakerPeriod.to ? speakerPeriod.to|date('Y-m-d') }}" onchange="this.form.submit()"></label>
                            </div>
                            {% if periodShortcuts is not empty %}
                                {% set currentPeriod = (speakerPeriod.from ? speakerPeriod.from|date('Y-m-d')) ~ '|' ~ (speakerPeriod.to ? speakerPeriod.to|date('Y-m-d')) %}
                                <div class="filters-sidebar__shortcuts">
                                    {% for shortcut in periodShortcuts %}
                                        <button type="submit" name="periode" value="{{ shortcut.value }}" class="filters-sidebar__shortcut{{ shortcut.value == currentPeriod ? ' is-active' }}">{{ shortcut.label }}</button>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if speakerPeriod.hasPeriod %}
                                <button type="submit" name="periode" value="clear" class="filters-sidebar__clear">Toutes les dates</button>
                            {% endif %}
                            <p class="muted lot-builder__hint">D’après la date du conseil des ministres.</p>
                        </details>

                        {% if speakerPeriod.isActive %}
                            <p class="lot-builder__hint">
                                {% if selectedSubjectIds is empty %}
                                    <strong>{{ lotSubjectCount }} sujet{{ lotSubjectCount > 1 ? 's' }}</strong> retenu{{ lotSubjectCount > 1 ? 's' }} d’office : passez directement aux langues et aux formats, ou cochez des sujets ci-dessous pour restreindre le lot.
                                {% else %}
                                    Le lot est limité aux sujets cochés ci-dessous. Décochez-les pour retenir tous les sujets de ce raccourci.
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>
                </details>

                {# Étape 1 : même calendrier que l'admin ; seuls les sujets du conseil choisi sont affichés.
                   Un sujet coché reste dans le lot quand on change de conseil (sa case, masquée, est toujours envoyée). #}
                <fieldset class="lot-builder__step" data-controller="council-calendar subject-search"
                          data-council-calendar-sessions-value="{{ calendar|json_encode }}"
                          data-council-calendar-selected-value="{{ selectedSessionId }}"
                          data-council-calendar-sync-url-value="true"
                          data-council-calendar-unit-value="sujet">
                    <legend><span class="lot-builder__step-number">1</span> Choisissez les sujets</legend>
                    <input type="hidden" name="conseil" value="{{ selectedSessionId }}" data-council-calendar-target="field">

                    {% if subjectRowsBySession is empty %}
                        <p class="empty-state">Aucun sujet publié pour le moment.</p>
                    {% else %}
                        <div class="lot-builder__council-layout">
                            {{ include('partials/_council_calendar.html.twig') }}

                            <div class="lot-builder__council-subjects">
                                {% if max(subjectRowsBySession|map(rows => rows|length)) > 8 %}
                                    <input
                                        type="search"
                                        class="lot-builder__subject-search-input"
                                        placeholder="Rechercher un sujet…"
                                        aria-label="Rechercher un sujet dans ce conseil"
                                        data-subject-search-target="input"
                                        data-action="input->subject-search#filter"
                                    >
                                {% endif %}

                                {% for sessionId, rows in subjectRowsBySession %}
                                    {% set councilSession = rows|first.subject.councilSession %}
                                    <div class="lot-builder__council-panel" data-council-calendar-target="panel" data-session-id="{{ sessionId }}"{{ sessionId != selectedSessionId ? ' hidden' }}>
                                        <p class="lot-builder__council-title">
                                            <strong>{{ councilSession.label ?: 'Conseil des ministres du ' ~ councilSession.date|date('d/m/Y') }}</strong>
                                            <span class="muted">{{ rows|length }} sujet{{ rows|length > 1 ? 's' }}</span>
                                        </p>
                                        <div class="lot-builder__subjects">
                                            {% for row in rows %}
                                                <label
                                                    class="lot-builder__subject"
                                                    style="--thematic-color: {{ row.subject.thematic.colorHex }}"
                                                    data-subject-search-target="item"
                                                    data-search-text="{{ (row.subject.title ~ ' ' ~ row.subject.thematic.name)|lower }}"
                                                >
                                                    <input type="checkbox" name="sujet[]" value="{{ row.subject.id }}"{{ row.subject.id in selectedSubjectIds ? ' checked' }} onchange="this.form.submit()">
                                                    <span class="lot-builder__subject-swatch" aria-hidden="true"></span>
                                                    <span class="lot-builder__subject-info">
                                                        <strong>{{ row.subject.title }}</strong>
                                                        <span class="muted">{{ row.subject.thematic.name }} · {{ row.videoCount }} contenu{{ row.videoCount > 1 ? 's' : '' }}</span>
                                                    </span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endfor %}
                                <p class="muted lot-builder__hint" data-subject-search-target="empty" hidden>Aucun sujet ne correspond à cette recherche.</p>
                                <p class="muted lot-builder__hint">Les sujets cochés restent dans votre lot si vous changez de conseil.</p>
                            </div>
                        </div>
                    {% endif %}
                </fieldset>

                <fieldset class="lot-builder__step">
                    <legend><span class="lot-builder__step-number">2</span> Choisissez les langues</legend>
                    {% if lotSubjectCount == 0 %}
                        <p class="muted">Choisissez d’abord un ou plusieurs sujets, ou utilisez le raccourci intervenant ou période.</p>
                    {% elseif availableLanguages is empty %}
                        <p class="muted">Aucune langue disponible pour cette sélection.</p>
                    {% else %}
                        <div class="filters-sidebar__options">
                            {% for language in availableLanguages %}
                                <label class="filters-sidebar__option">
                                    <input type="checkbox" name="langue[]" value="{{ language.id }}"{{ language.id in selectedLanguageIds ? ' checked' }} onchange="this.form.submit()">
                                    <span>{{ language.name }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        <p class="muted lot-builder__hint">Aucune langue cochée = toutes les langues disponibles.</p>
                    {% endif %}
                </fieldset>

                <fieldset class="lot-builder__step">
                    <legend><span class="lot-builder__step-number">3</span> Choisissez les formats</legend>
                    {% if lotSubjectCount == 0 %}
                        <p class="muted">Choisissez d’abord un ou plusieurs sujets, ou utilisez le raccourci intervenant ou période.</p>
                    {% elseif availableFormats is empty %}
                        <p class="muted">Aucun format disponible pour cette sélection.</p>
                    {% else %}
                        <div class="filters-sidebar__options">
                            {% for format in availableFormats %}
                                <label class="filters-sidebar__option">
                                    <input type="checkbox" name="format[]" value="{{ format.value }}"{{ format.value in selectedFormatValues ? ' checked' }} onchange="this.form.submit()">
                                    <span>{{ format.label }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        <p class="muted lot-builder__hint">Aucun format coché = tous les formats disponibles.</p>
                    {% endif %}
                </fieldset>
            </form>

            <aside class="lot-builder__summary">
                <h2>Votre lot</h2>

                <dl class="lot-builder__summary-list">
                    <div>
                        <dt>Sujets</dt>
                        <dd>{{ lotSubjectCount }}</dd>
                    </div>
                    {% if speakerPeriod.isActive %}
                        <div class="lot-builder__summary-wide">
                            <dt>Raccourci</dt>
                            <dd>{{ speakerPeriod.hasPerson ? speakerPeriod.personName }}{{ speakerPeriod.hasPerson and speakerPeriod.hasPeriod ? ', ' }}{{ speakerPeriod.periodLabel }}</dd>
                        </div>
                    {% endif %}
                    <div>
                        <dt>Langues</dt>
                        <dd>{{ selectedLanguageIds is empty ? 'Toutes' : selectedLanguageIds|length }}</dd>
                    </div>
                    <div>
                        <dt>Formats</dt>
                        <dd>{{ selectedFormatValues is empty ? 'Tous' : selectedFormatValues|length }}</dd>
                    </div>
                    <div>
                        <dt>Fichiers</dt>
                        <dd>{{ matchingFiles|length }}</dd>
                    </div>
                </dl>

                <p class="lot-builder__summary-total">
                    <span class="lot-builder__step-number">4</span>
                    Poids total : <strong>{{ (totalSize / 1048576)|round(1) }} Mo</strong>
                </p>

                {% if matchingFiles is not empty %}
                    <form method="post" action="{{ path('app_media_space_download') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">
                        {% for id in selectedSubjectIds %}<input type="hidden" name="sujet[]" value="{{ id }}">{% endfor %}
                        {% for id in selectedLanguageIds %}<input type="hidden" name="langue[]" value="{{ id }}">{% endfor %}
                        {% for value in selectedFormatValues %}<input type="hidden" name="format[]" value="{{ value }}">{% endfor %}
                        <input type="hidden" name="conseil" value="{{ selectedSessionId }}">
                        {% for name, value in speakerPeriod.queryParams %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}

                        <p class="muted lot-builder__hint">
                            <span class="lot-builder__step-number">5</span>
                            Le lot est livré avec sa fiche d’attribution (liste des contenus et mention obligatoire à respecter).
                        </p>

                        <button type="submit" class="btn btn--primary lot-builder__download">Télécharger le lot (.zip)</button>
                    </form>
                {% else %}
                    <p class="muted">Choisissez au moins un sujet, ou un intervenant ou une période, pour composer votre lot.</p>
                {% endif %}
            </aside>
        </div>
    </section>

    <section class="section wrap cta-grid cta-grid--single">
        <div class="cta-card cta-card--dark">
            <h3>Un besoin que le catalogue ne couvre pas ?</h3>
            <p>Les capsules publiées sont en libre accès, sans compte ni demande préalable. Contactez la Direction de la communication (Dircom) uniquement pour un format sur mesure, un fichier en très haute définition, une question d’accréditation, ou un besoin non couvert par le catalogue.</p>
            <a class="btn btn--gold" href="{{ path('app_suggestion_new') }}">Nous contacter</a>
        </div>
    </section>
{% endblock %}
