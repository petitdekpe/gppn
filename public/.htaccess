DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Determine the RewriteBase automatically and set it as environment variable.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # If the requested filename exists, simply serve it.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{ENV:BASE}/index.php -f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# ------------------------------------------------------------------------
# Sécurité : on bloque tout accès direct aux fichiers sensibles s'ils
# devaient se retrouver dans public/ (config, env, dotfiles, dépôt git...).
# ------------------------------------------------------------------------
<FilesMatch "(^\.|\.env(\..*)?$|composer\.(json|lock)$|symfony\.lock$|\.ya?ml$|\.dist$|\.log$|\.sql(ite3?)?$|\.twig$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Empêche le navigateur de deviner un type MIME différent de celui envoyé
    Header always set X-Content-Type-Options "nosniff"
    # Le site n'a pas vocation à être embarqué dans une frame tierce
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Ne pas envoyer les en-têtes de cache sur le contenu dynamique (PHP)
    <FilesMatch "\.php$">
        Header unset Cache-Control
        Header unset Expires
        Header unset Pragma
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------
# Compression : réduit la taille du texte transféré (HTML/CSS/JS/JSON/SVG).
# On exclut volontairement les vidéos/audios/archives, déjà compressés :
# les recompresser gaspille du CPU et casse le support des requêtes Range
# (lecture/seek vidéo) sur certains serveurs.
# ------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
    AddOutputFilterByType DEFLATE image/svg+xml

    <IfModule mod_setenvif.c>
        BrowserMatch \.(?:mp4|mp3|webm|mkv|mov|zip|gz|pdf)$ no-gzip dont-vary
    </IfModule>
</IfModule>

# ------------------------------------------------------------------------
# Cache navigateur.
# - /assets/ (AssetMapper) est versionné par hash de contenu dans le nom de
#   fichier : un cache long et "immutable" est donc sans risque.
# - /uploads/ et /downloads/ (vidéos, miniatures, fichiers à télécharger)
#   changent rarement une fois publiés : cache modéré (30 jours).
# - Le reste (favicon, robots.txt...) garde un cache court par défaut.
# ------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/(uploads|downloads)/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
</IfModule>

# Désactive le listing de répertoire si mod_autoindex est présent
Options -Indexes
